package assessment;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.edge.EdgeDriver;

public class day4testcase03 {

	public static void main(String[] args) throws InterruptedException {
		//launch the browser
		WebDriver driver = new EdgeDriver();
		//maximize
		driver.manage().window().maximize();
		//implicit
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		//navigate to BigBasket application
		driver.get("https://www.bigbasket.com/");
		Thread.sleep(2000);
		// search for any product
		WebElement search = driver.findElement(By.xpath("(//input[@class='flex-1 w-full leading-md lg:text-sm xl:text-md placeholder-silverSurfer-700'])[2]"));
		search.sendKeys("Yogurt",Keys.ENTER);
		Thread.sleep(2000);
		//add any product to cart
		WebElement product = driver.findElement(By.xpath("//button[text()='Add']"));
		product.click();
		Thread.sleep(3000);
		//check in cart
		WebElement cart = driver.findElement(By.cssSelector("[class='mx-4 flex-1']"));
		if(cart.getText().contains("An item has been added to your basket successfully"))
		{
			System.out.println("An item is added to cart");
		}
		else
		{
			System.out.println("An item is not added to cart");
		}
		Thread.sleep(2000);
		//close
		driver.quit();
	}

}

